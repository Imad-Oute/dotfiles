# HyDE auto-generated — overwritten on every theme/wallpaper switch
.config/hypr/themes/

# Wallpapers — binary files, documented in wallpapers.md instead
.config/hyde/themes/*/wallpapers/
.config/hyde/themes/*/wall.set
.config/hyde/themes/*/wall.hyprlock.png

# Secrets — never commit
home/.zshrc.local

# Runtime noise
.config/btop/*.log
.config/fastfetch/cache/

# Editor
*.swp
*.swo
*~
.DS_Store

# Backups (e.g. starship.toml.bak created before edits)
*.bak

# themeforge: generated artefacts — rebuilt by `themeforge/forge.py install all` (run by install.sh)
themeforge/build/
.config/hypr/hyprlock/Glass.conf
.config/hypr/hyprlock/BlackArch.conf
# machine-specific monitor layouts written by nwg-displays / HyDE
.config/hypr/monitors.lua
.config/hypr/workspaces.lua

# Python bytecode
__pycache__/
*.pyc
