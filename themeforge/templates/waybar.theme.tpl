$HOME/.config/waybar/theme.css|${scrDir}/wbarconfgen.sh

/* {{ meta.name }} — generated by themeforge from tokens/{{ meta.slug }}.toml. DO NOT EDIT. */

/* ── HyDE contract (variables consumed by defaults.css) ─────────────────── */
@define-color bar-bg   {{ palette.bg | a:0 | css }};
@define-color main-bg  {{ palette.base | a:glass.pill_alpha | css }};
@define-color main-fg  {{ palette.text | css }};
@define-color wb-act-bg {{ palette.accent | css }};
@define-color wb-act-fg {{ palette.on_accent | css }};
@define-color wb-hvr-bg {{ palette.raised2 | a:0.85 | css }};
@define-color wb-hvr-fg {{ palette.text | css }};
@define-color wb-color  {{ palette.text | css }};
@define-color wb-act-color {{ palette.on_accent | css }};
@define-color wb-hvr-color {{ palette.text | css }};

/* ── Theme tokens as named colours (usable by user-style.css too) ───────── */
@define-color t-bg      {{ palette.bg | css }};
@define-color t-base    {{ palette.base | css }};
@define-color t-raised  {{ palette.raised | css }};
@define-color t-text2   {{ palette.text2 | css }};
@define-color t-text3   {{ palette.text3 | css }};
@define-color t-accent  {{ palette.accent | css }};
@define-color t-red     {{ palette.red | css }};
@define-color t-orange  {{ palette.orange | css }};
@define-color t-green   {{ palette.green | css }};
@define-color t-sep     {{ palette.separator | css }};

/* ── Shape & material ───────────────────────────────────────────────────── */
window#waybar {
    background: transparent;
    font-family: "{{ meta.font }}", "Inter", sans-serif;
    font-weight: 500;
}

#leaf, #leaf-inverse, #leaf-up, #leaf-down, #leaf-right, #leaf-left,
#pill, #pill-right, #pill-left, #pill-down, #pill-up, #pill-in, #pill-out {
    background-color: @main-bg;
    border: {{ shape.border }}px solid {% if fx %}{{ palette.text | a:glass.rim_lo | css }}{% else %}{{ palette.separator | css }}{% endif %};
    border-radius: {{ shape.radius_sm }}px;
{% if fx %}
    /* specular top edge + soft lift */
    box-shadow: inset 0 1px 0 {{ palette.text | a:glass.rim_hi | css }},
                0 {{ glass.shadow_y }}px {{ glass.shadow_range }}px {{ glass.shadow_color | a:glass.shadow_alpha | css }};
{% endif %}
}

/* ── Shape ownership ──────────────────────────────────────────────────────
 * HyDE's includes/border-radius.css copies Hyprland's rounding at switch time (one step stale) and uses
 * higher-specificity selectors, so we re-declare the same selectors and take the radius from the tokens. */
window#waybar.top #leaf,
window#waybar.bottom #leaf,
window#waybar.top #leaf-inverse,
window#waybar.bottom #leaf-inverse,
window#waybar.top #leaf-up,
window#waybar.bottom #leaf-up,
window#waybar.top #leaf-down,
window#waybar.bottom #leaf-down,
window#waybar.top #leaf-right,
window#waybar.bottom #leaf-right,
window#waybar.top #leaf-left,
window#waybar.bottom #leaf-left,
window#waybar.top #pill,
window#waybar.bottom #pill,
window#waybar.top #pill-right,
window#waybar.bottom #pill-right,
window#waybar.top #pill-left,
window#waybar.bottom #pill-left,
window#waybar.top #pill-down,
window#waybar.bottom #pill-down,
window#waybar.top #pill-up,
window#waybar.bottom #pill-up,
window#waybar.top #pill-in,
window#waybar.bottom #pill-in,
window#waybar.top #pill-out,
window#waybar.bottom #pill-out {
    border-radius: {{ shape.radius_sm }}px;
}

/* Buttons inside a group inherit the group's (leaf) radius in HyDE; give them the token radius instead. */
window#waybar.top #leaf button,
window#waybar.bottom #leaf button,
window#waybar.top #leaf-inverse button,
window#waybar.bottom #leaf-inverse button,
window#waybar.top #leaf-up button,
window#waybar.bottom #leaf-up button,
window#waybar.top #leaf-down button,
window#waybar.bottom #leaf-down button,
window#waybar.top #leaf-right button,
window#waybar.bottom #leaf-right button,
window#waybar.top #leaf-left button,
window#waybar.bottom #leaf-left button,
window#waybar.top #pill button,
window#waybar.bottom #pill button,
window#waybar.top #pill-right button,
window#waybar.bottom #pill-right button,
window#waybar.top #pill-left button,
window#waybar.bottom #pill-left button,
window#waybar.top #pill-down button,
window#waybar.bottom #pill-down button,
window#waybar.top #pill-up button,
window#waybar.bottom #pill-up button,
window#waybar.top #pill-in button,
window#waybar.bottom #pill-in button,
window#waybar.top #pill-out button,
window#waybar.bottom #pill-out button {
    border-radius: {{ shape.radius_xs }}px;
}

#workspaces button {
    border-radius: {{ shape.radius_xs }}px;
    color: {{ palette.text2 | css }};
}
#workspaces button.active {
    background: @wb-act-bg;
    color: @wb-act-fg;
{% if fx %}
    box-shadow: inset 0 1px 0 {{ palette.text | a:0.35 | css }},
                0 2px 10px {{ palette.accent | a:0.45 | css }};
{% endif %}
}
#workspaces button.urgent {
    background: {{ palette.red | css }};
    color: {{ palette.text | css }};
}
#workspaces button:hover {
    background: @wb-hvr-bg;
    color: @wb-hvr-fg;
}

/* ── Tooltips / menus: heavier material than the bar ────────────────────── */
tooltip {
    background: {{ palette.base | a:glass.popup_alpha | css }};
    color: {{ palette.text | css }};
    border: {{ shape.border }}px solid {% if fx %}{{ palette.text | a:glass.rim_lo | css }}{% else %}{{ palette.separator | css }}{% endif %};
    border-radius: {{ shape.radius_sm }}px;
}
tooltip label { color: {{ palette.text | css }}; }
menu {
    background: {{ palette.base | a:glass.popup_alpha | css }};
    border: {{ shape.border }}px solid {{ palette.separator | css }};
    border-radius: {{ shape.radius_sm }}px;
    color: {{ palette.text | css }};
}
menuitem:hover { background: {{ palette.accent | css }}; color: {{ palette.on_accent | css }}; }

/* ── State semantics (battery, network, audio, tray) ───────────────────── */
#battery.charging, #battery.plugged { color: {{ palette.green | css }}; }
#battery.warning:not(.charging) { color: {{ palette.orange | css }}; }
#battery.critical:not(.charging) { color: {{ palette.red | css }}; }
#network.disconnected, #pulseaudio.muted, #wireplumber.muted { color: {{ palette.text3 | css }}; }
#tray > .passive { -gtk-icon-effect: dim; }
#tray > .needs-attention { -gtk-icon-effect: highlight; background: {{ palette.red | a:0.4 | css }}; }
#clock { font-weight: 600; letter-spacing: 0.02em; }
