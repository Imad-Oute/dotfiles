# {{ meta.name }} lockscreen — generated by themeforge from tokens/{{ meta.slug }}.toml. DO NOT EDIT.
# Colours come from $wallbash_* so it follows the active mode (theme / auto / dark / light);
# material (radius, glass fill, rim) comes from the tokens.

$resolve.font={{ meta.font }}

general {
    hide_cursor = true
    ignore_empty_input = true
}

background {
    monitor =
    path = $BACKGROUND_PATH
{% if fx %}
    blur_passes = 4
    blur_size = 8
    noise = {{ glass.noise }}
    contrast = 0.95
    brightness = 0.78
    vibrancy = {{ glass.vibrancy }}
    vibrancy_darkness = 0.0
{% else %}
    blur_passes = 0
    brightness = 0.55
{% endif %}
}

# DATE
label {
    monitor =
    text = cmd[update:1000] echo -e "$(date +"%A, %B %d")"
    color = $wallbash_txt1_rgba
    font_size = 24
    font_family = {{ meta.font }} Medium
    position = 0, 340
    halign = center
    valign = center
}

# TIME
label {
    monitor =
    text = cmd[update:1000] echo "$(date +"%H:%M")"
    color = $wallbash_txt1_rgba
    font_size = 150
    font_family = {{ meta.font }} Bold
    position = 0, 230
    halign = center
    valign = center
}

# PANEL
shape {
    monitor =
    size = 440, 250
    color = {{ palette.text | a:0.10 | css }}
    rounding = {% if fx %}40{% else %}0{% endif %}
    border_size = {{ shape.border }}
    border_color = {% if fx %}{{ palette.text | a:glass.rim_hi | css }}{% else %}$wallbash_2xa5_rgba{% endif %}
    rotate = 0
    xray = false
    position = 0, -130
    halign = center
    valign = center
}

# AVATAR
image {
    monitor =
    path = $PROFILE_IMAGE
    size = 76
    rounding = {% if fx %}-1{% else %}0{% endif %}
    border_size = 2
    border_color = {% if fx %}{{ palette.text | a:0.55 | css }}{% else %}$wallbash_2xa5_rgba{% endif %}
    position = 0, -70
    halign = center
    valign = center
}

# NAME
label {
    monitor =
    text = $USER
    color = $wallbash_txt1_rgba
    font_size = 18
    font_family = {{ meta.font }} Bold
    position = 0, -128
    halign = center
    valign = center
}

# PASSWORD
input-field {
    monitor =
    size = 360, 52
    outline_thickness = 1
    dots_size = 0.26
    dots_spacing = 0.3
    dots_center = true
    rounding = {% if fx %}-1{% else %}0{% endif %}
    outer_color = {% if fx %}{{ palette.text | a:0.30 | css }}{% else %}$wallbash_2xa5_rgba{% endif %}
    inner_color = {{ palette.text | a:0.10 | css }}
    font_color = $wallbash_txt1_rgba
    check_color = $wallbash_2xa5_rgba
    fail_color = {{ palette.red | css }}
    capslock_color = {{ palette.orange | css }}
    fade_on_empty = false
    font_family = {{ meta.font }} Medium
    placeholder_text = <span foreground="##ffffffaa">Enter Password</span>
    fail_text = <b>$FAIL</b> ($ATTEMPTS)
    fail_transition = 300
    position = 0, -192
    halign = center
    valign = center
}

# BATTERY
label {
    monitor =
    text = cmd[update:5000] $BATTERY_ICON
    color = $wallbash_txt1_rgba
    font_size = 20
    font_family = JetBrainsMono Nerd Font
    position = -1%, 1%
    halign = right
    valign = bottom
}

# KEYBOARD LAYOUT
label {
    monitor =
    text = $LAYOUT
    color = $wallbash_txt1_rgba
    font_size = 18
    font_family = {{ meta.font }} Medium
    position = -3%, 1%
    halign = right
    valign = bottom
}
