$HOME/.config/rofi/theme.rasi
/* {{ meta.name }} — generated by themeforge */
* {
    main-bg:            {{ palette.base | a:glass.popup_alpha | rasi }};
    main-fg:            {{ palette.text | rasi }};
    main-br:            {% if fx %}{{ palette.text | a:glass.rim_hi | rasi }}{% else %}{{ palette.accent | rasi }}{% endif %};
    main-ex:            {{ palette.accent | rasi }};
    select-bg:          {{ palette.accent | rasi }};
    select-fg:          {{ palette.on_accent | rasi }};
    glass-fill:         {{ palette.text | a:0.09 | rasi }};
    glass-rim:          {% if fx %}{{ palette.text | a:glass.rim_lo | rasi }}{% else %}{{ palette.separator | rasi }}{% endif %};
    glass-dim:          {{ palette.text3 | rasi }};
{% if !fx %}
    glass-r-window:     0px;
    glass-r-input:      0px;
    glass-r-item:       0px;
{% endif %}
    separatorcolor:     transparent;
    border-color:       transparent;
}
