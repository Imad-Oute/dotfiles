# {{ meta.name }} — generated by themeforge from tokens/{{ meta.slug }}.toml. DO NOT EDIT.
# Re-maps catppuccin/tmux's @thm_* palette so the status bar follows the HyDE theme.
# Sourced from ~/.tmux.conf AFTER `run tpm` (modules read @thm_* lazily at render time).

set -g @thm_rosewater "{{ palette.pink | lighten:0.20 | hash }}"
set -g @thm_flamingo  "{{ palette.pink | lighten:0.10 | hash }}"
set -g @thm_pink      "{{ palette.pink | hash }}"
set -g @thm_mauve     "{{ palette.accent | hash }}"
set -g @thm_red       "{{ palette.red | hash }}"
set -g @thm_maroon    "{{ palette.red | darken:0.08 | hash }}"
set -g @thm_peach     "{{ palette.orange | hash }}"
set -g @thm_yellow    "{{ palette.yellow | hash }}"
set -g @thm_green     "{{ palette.green | hash }}"
set -g @thm_teal      "{{ palette.teal | hash }}"
set -g @thm_sky       "{{ palette.teal | lighten:0.08 | hash }}"
set -g @thm_sapphire  "{{ palette.accent_hi | hash }}"
set -g @thm_blue      "{{ palette.accent | hash }}"
set -g @thm_lavender  "{{ palette.indigo | hash }}"

set -g @thm_text      "{{ palette.text | hash }}"
set -g @thm_subtext_1 "{{ palette.text2 | hash }}"
set -g @thm_subtext_0 "{{ palette.text2 | darken:0.10 | hash }}"
set -g @thm_overlay_2 "{{ palette.text3 | lighten:0.08 | hash }}"
set -g @thm_overlay_1 "{{ palette.text3 | hash }}"
set -g @thm_overlay_0 "{{ palette.text3 | darken:0.08 | hash }}"
set -g @thm_surface_2 "{{ palette.separator | hash }}"
set -g @thm_surface_1 "{{ palette.raised2 | hash }}"
set -g @thm_surface_0 "{{ palette.raised | hash }}"
set -g @thm_base      "{{ ansi.term_bg | hash }}"
set -g @thm_mantle    "{{ ansi.term_bg | darken:0.02 | hash }}"
set -g @thm_crust     "{{ ansi.term_bg | darken:0.04 | hash }}"

# window-tab pills: lit accent for the active window (number block), neutral surface otherwise
set -g @catppuccin_window_current_number_color "{{ palette.accent | hash }}"
set -g @catppuccin_window_number_color         "{{ palette.raised2 | hash }}"
