/* {{ meta.name }} — GTK3. Generated by themeforge from tokens/{{ meta.slug }}.toml. DO NOT EDIT.
 * Strategy: inherit Adwaita's complete widget set (so nothing is ever unstyled), then
 * re-bind every named colour to the tokens and layer the material/shape on top. */
@import url("resource:///org/gtk/libgtk/theme/Adwaita/gtk-contained{{ meta.sfx }}.css");
/* ── Palette binding: follows the ACTIVE wallbash palette (theme/auto/dark/light modes) ── */
@import url("file://{{ meta.home }}/.cache/hyde/wallbash/gtk.css");
@define-color g_bg @wallbash_pry1;
@define-color g_base @wallbash_pry1;
@define-color g_raised @wallbash_1xa1;
@define-color g_raised2 @wallbash_1xa2;
@define-color g_separator @wallbash_1xa3;
@define-color g_text @wallbash_txt1;
@define-color g_text2 @wallbash_1xa7;
@define-color g_text3 @wallbash_1xa4;
@define-color g_accent @wallbash_2xa5;
@define-color g_accent_hi @wallbash_2xa7;
@define-color g_accent_lo @wallbash_2xa3;
@define-color g_on_accent @wallbash_txt2;
@define-color g_accent2 @wallbash_3xa5;
@define-color g_red {{ palette.red | css }};
@define-color g_orange {{ palette.orange | css }};
@define-color g_yellow {{ palette.yellow | css }};
@define-color g_green {{ palette.green | css }};
@define-color g_teal {{ palette.teal | css }};
@define-color g_pink {{ palette.pink | css }};
@define-color g_indigo {{ palette.indigo | css }};


/* ── Named colours (Adwaita contract) ───────────────────────────────────── */
@define-color theme_bg_color            @g_bg;
@define-color theme_fg_color            @g_text;
@define-color theme_base_color          @g_base;
@define-color theme_text_color          @g_text;
@define-color theme_selected_bg_color   @g_accent;
@define-color theme_selected_fg_color   @g_on_accent;
@define-color theme_unfocused_bg_color  @g_bg;
@define-color theme_unfocused_fg_color  @g_text2;
@define-color theme_unfocused_base_color @g_base;
@define-color theme_unfocused_text_color @g_text2;
@define-color theme_unfocused_selected_bg_color @g_accent_lo;
@define-color theme_unfocused_selected_bg_color_alt @g_accent_lo;
@define-color theme_unfocused_selected_fg_color @g_on_accent;
@define-color insensitive_bg_color      @g_raised;
@define-color insensitive_fg_color      @g_text3;
@define-color insensitive_base_color    @g_base;
@define-color theme_unfocused_insensitive_bg_color @g_raised;
@define-color borders                   @g_separator;
@define-color unfocused_borders         @g_separator;
@define-color warning_color             @g_orange;
@define-color error_color               @g_red;
@define-color success_color             @g_green;
@define-color link_color                @g_accent_hi;
@define-color link_visited_color        @g_accent2;
@define-color placeholder_text_color    @g_text3;
@define-color content_view_bg           @g_base;
@define-color wm_title                  @g_text;
@define-color wm_unfocused_title        @g_text3;
@define-color wm_bg                     @g_bg;
@define-color wm_border                 @g_separator;
@define-color tooltip_bg_color          alpha(@g_base, {{ glass.popup_alpha }});
@define-color tooltip_fg_color          @g_text;
@define-color osd_bg                    alpha(@g_base, {{ glass.popup_alpha }});
@define-color osd_fg                    @g_text;

/* ── Shape ──────────────────────────────────────────────────────────────── */
button, entry, spinbutton, combobox button, .linked > button:first-child, .linked > button:last-child {
    border-radius: {{ shape.radius_sm }}px;
}
.linked > button, .linked > entry { border-radius: 0; }
.linked > button:first-child, .linked > entry:first-child { border-top-left-radius: {{ shape.radius_sm }}px; border-bottom-left-radius: {{ shape.radius_sm }}px; }
.linked > button:last-child,  .linked > entry:last-child  { border-top-right-radius: {{ shape.radius_sm }}px; border-bottom-right-radius: {{ shape.radius_sm }}px; }

menu, .popup, popover, popover.background, .menu {
    border-radius: {{ shape.radius_sm }}px;
}
menuitem { border-radius: {{ shape.radius_xs }}px; margin: 2px 4px; }
tooltip, tooltip.background { border-radius: {{ shape.radius_sm }}px; }
scrollbar slider { border-radius: {{ shape.radius }}px; min-width: 6px; min-height: 6px; }
progressbar trough, progressbar progress, scale trough, scale highlight, levelbar block { border-radius: {{ shape.radius }}px; }
switch, switch slider { border-radius: {{ shape.radius }}px; }
notebook > header > tabs > tab { border-radius: {{ shape.radius_xs }}px; }

/* client-side decorations */
decoration {
    border-radius: {{ shape.radius }}px;
{% if fx %}
    box-shadow: 0 {{ glass.shadow_y }}px {{ glass.shadow_range }}px {{ glass.shadow_color | a:glass.shadow_alpha | css }},
                0 0 0 1px alpha(@g_text, {{ glass.rim_lo }});
{% else %}
    box-shadow: 0 0 0 1px @g_separator;
{% endif %}
}
decoration:backdrop { box-shadow: 0 0 0 1px @g_separator; }
window.csd, window.csd decoration { border-radius: {{ shape.radius }}px; }

/* ── Material ───────────────────────────────────────────────────────────── */
headerbar, .titlebar {
    background-image: none;
    background-color: alpha(@g_base, {{ glass.pill_alpha }});
    border-bottom: 1px solid @g_separator;
    border-top-left-radius: {{ shape.radius }}px;
    border-top-right-radius: {{ shape.radius }}px;
{% if fx %}
    box-shadow: inset 0 1px 0 alpha(@g_text, {{ glass.rim_hi }});
{% else %}
    box-shadow: none;
{% endif %}
}
headerbar:backdrop { background-color: @g_bg; }

button {
    background-image: none;
    background-color: @g_raised;
    color: @g_text;
    border: 1px solid @g_separator;
{% if fx %}
    box-shadow: inset 0 1px 0 alpha(@g_text, 0.10);
{% else %}
    box-shadow: none;
{% endif %}
    transition: all 180ms cubic-bezier({{ motion.bezier }});
}
button:hover  { background-color: @g_raised2; }
button:active, button:checked { background-color: @g_accent; color: @g_on_accent; border-color: @g_accent; }
button.suggested-action { background-color: @g_accent; color: @g_on_accent; border-color: @g_accent; }
button.suggested-action:hover { background-color: @g_accent_hi; }
button.destructive-action { background-color: @g_red; color: @g_text; border-color: @g_red; }
button.flat, headerbar button.flat { background-color: transparent; border-color: transparent; box-shadow: none; }
button.flat:hover { background-color: @g_raised; }

entry, spinbutton, textview text, .view {
    background-color: @g_base;
    color: @g_text;
    border: 1px solid @g_separator;
    box-shadow: none;
}
entry:focus, spinbutton:focus-within { border-color: @g_accent; box-shadow: 0 0 0 3px alpha(@g_accent, 0.30); }
selection, .view:selected, entry selection, textview text selection { background-color: @g_accent; color: @g_on_accent; }

menu, .popup, popover, popover.background {
    background-color: alpha(@g_base, {{ glass.popup_alpha }});
    border: 1px solid {% if fx %}alpha(@g_text, {{ glass.rim_lo }}){% else %}@g_separator{% endif %};
    color: @g_text;
}
menuitem:hover, row:selected, .sidebar row:selected, treeview.view:selected {
    background-color: @g_accent; color: @g_on_accent;
}
.sidebar, placessidebar, .sidebar .view { background-color: alpha(@g_base, {{ glass.pill_alpha }}); }
scrollbar slider { background-color: alpha(@g_text3, 0.55); }
scrollbar slider:hover { background-color: alpha(@g_text2, 0.75); }
switch:checked { background-color: @g_green; border-color: @g_green; }
progressbar progress, scale highlight, levelbar block.filled { background-color: @g_accent; background-image: none; }
separator { background-color: @g_separator; }
tooltip, tooltip.background {
    background-color: alpha(@g_base, {{ glass.popup_alpha }});
    border: 1px solid @g_separator;
    color: @g_text;
}
