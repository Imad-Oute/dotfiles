/* {{ meta.name }} — GTK4 / libadwaita. Generated by themeforge from tokens/{{ meta.slug }}.toml. DO NOT EDIT.
 * libadwaita is driven by named colours; we bind all of them to the tokens, then adjust shape & material. */

/* ── Palette binding: follows the ACTIVE wallbash palette (theme/auto/dark/light modes) ── */
@import url("file://{{ meta.home }}/.cache/hyde/wallbash/gtk.css");
@define-color g_bg @wallbash_pry1;
@define-color g_base @wallbash_pry1;
@define-color g_raised @wallbash_1xa1;
@define-color g_raised2 @wallbash_1xa2;
@define-color g_separator @wallbash_1xa3;
@define-color g_text @wallbash_txt1;
@define-color g_text2 @wallbash_1xa7;
@define-color g_text3 @wallbash_1xa4;
@define-color g_accent @wallbash_2xa5;
@define-color g_accent_hi @wallbash_2xa7;
@define-color g_accent_lo @wallbash_2xa3;
@define-color g_on_accent @wallbash_txt2;
@define-color g_accent2 @wallbash_3xa5;
@define-color g_red {{ palette.red | css }};
@define-color g_orange {{ palette.orange | css }};
@define-color g_yellow {{ palette.yellow | css }};
@define-color g_green {{ palette.green | css }};
@define-color g_teal {{ palette.teal | css }};
@define-color g_pink {{ palette.pink | css }};
@define-color g_indigo {{ palette.indigo | css }};

/* ── Accent & semantic ─────────────────────────────────────────────────── */
@define-color accent_color            @g_accent_hi;
@define-color accent_bg_color         @g_accent;
@define-color accent_fg_color         @g_on_accent;
@define-color destructive_color       @g_red;
@define-color destructive_bg_color    @g_red;
@define-color destructive_fg_color    @g_text;
@define-color success_color           @g_green;
@define-color success_bg_color        @g_green;
@define-color success_fg_color        @g_bg;
@define-color warning_color           @g_orange;
@define-color warning_bg_color        @g_orange;
@define-color warning_fg_color        @g_bg;
@define-color error_color             @g_red;
@define-color error_bg_color          @g_red;
@define-color error_fg_color          @g_text;

/* ── Surfaces ──────────────────────────────────────────────────────────── */
@define-color window_bg_color         @g_bg;
@define-color window_fg_color         @g_text;
@define-color view_bg_color           @g_base;
@define-color view_fg_color           @g_text;
@define-color headerbar_bg_color      @g_base;
@define-color headerbar_fg_color      @g_text;
@define-color headerbar_border_color  @g_separator;
@define-color headerbar_backdrop_color @g_bg;
@define-color headerbar_shade_color   {{ glass.shadow_color | a:0.25 | css }};
@define-color headerbar_darker_shade_color {{ glass.shadow_color | a:0.35 | css }};
@define-color sidebar_bg_color        @g_base;
@define-color sidebar_fg_color        @g_text;
@define-color sidebar_backdrop_color  @g_bg;
@define-color sidebar_shade_color     {{ glass.shadow_color | a:0.20 | css }};
@define-color secondary_sidebar_bg_color @g_bg;
@define-color secondary_sidebar_fg_color @g_text;
@define-color secondary_sidebar_backdrop_color @g_bg;
@define-color secondary_sidebar_shade_color {{ glass.shadow_color | a:0.20 | css }};
@define-color card_bg_color           @g_raised;
@define-color card_fg_color           @g_text;
@define-color card_shade_color        {{ glass.shadow_color | a:0.18 | css }};
@define-color dialog_bg_color         @g_base;
@define-color dialog_fg_color         @g_text;
@define-color popover_bg_color        @g_base;
@define-color popover_fg_color        @g_text;
@define-color popover_shade_color     {{ glass.shadow_color | a:0.18 | css }};
@define-color shade_color             {{ glass.shadow_color | a:0.25 | css }};
@define-color scrollbar_outline_color alpha(@g_bg, 0.6);
@define-color thumbnail_bg_color      @g_raised;
@define-color thumbnail_fg_color      @g_text;

/* ── Shape ─────────────────────────────────────────────────────────────── */
window.csd, window.csd decoration, window.background.csd { border-radius: {{ shape.radius }}px; }
button, entry, spinbutton, dropdown > button, .pill, splitbutton > button { border-radius: {{ shape.radius_sm }}px; }
.card, .boxed-list, list.boxed-list, preferencesgroup > box > box > list { border-radius: {{ shape.radius_sm }}px; }
popover > contents, popover.menu > contents { border-radius: {{ shape.radius_sm }}px; }
row, listview > row, .navigation-sidebar > row { border-radius: {{ shape.radius_xs }}px; }
tooltip { border-radius: {{ shape.radius_sm }}px; }
scrollbar slider { border-radius: {{ shape.radius }}px; }

/* ── Material ──────────────────────────────────────────────────────────── */
headerbar, .titlebar {
    background-color: alpha(@g_base, {{ glass.pill_alpha }});
    border-bottom: 1px solid @g_separator;
{% if fx %}
    box-shadow: inset 0 1px 0 alpha(@g_text, {{ glass.rim_hi }});
{% else %}
    box-shadow: none;
{% endif %}
}
headerbar:backdrop { background-color: @g_bg; }

window.csd {
{% if fx %}
    box-shadow: 0 {{ glass.shadow_y }}px {{ glass.shadow_range }}px {{ glass.shadow_color | a:glass.shadow_alpha | css }},
                0 0 0 1px alpha(@g_text, {{ glass.rim_lo }});
{% else %}
    box-shadow: 0 0 0 1px @g_separator;
{% endif %}
}

popover > contents {
    background-color: alpha(@g_base, {{ glass.popup_alpha }});
    border: 1px solid {% if fx %}alpha(@g_text, {{ glass.rim_lo }}){% else %}@g_separator{% endif %};
}

button {
    transition: all 180ms cubic-bezier({{ motion.bezier }});
{% if fx %}
    box-shadow: inset 0 1px 0 alpha(@g_text, 0.08);
{% endif %}
}
entry:focus-within { box-shadow: 0 0 0 3px alpha(@g_accent, 0.30); }
switch:checked { background-color: @g_green; }
.card, .boxed-list { background-color: alpha(@g_raised, {{ glass.pill_alpha }}); border: 1px solid @g_separator; }
.sidebar-pane, .navigation-sidebar { background-color: alpha(@g_base, {{ glass.pill_alpha }}); }
