$HOME/.config/hypr/themes/theme.conf|> $HOME/.config/hypr/themes/colors.conf

# {{ meta.name }} — generated by themeforge from tokens/{{ meta.slug }}.toml. DO NOT EDIT; edit the tokens.

$GTK_THEME = {{ meta.gtk }}
$ICON_THEME = {{ meta.icon }}
$COLOR_SCHEME = prefer-{{ meta.mode }}
$CURSOR_THEME = {{ meta.cursor }}
$CURSOR_SIZE = {{ meta.cursor_size }}
$FONT = {{ meta.font }}
$FONT_SIZE = {{ meta.font_size }}
$DOCUMENT_FONT = {{ meta.font }}
$DOCUMENT_FONT_SIZE = {{ meta.font_size }}
$MONOSPACE_FONT = {{ meta.mono }}
$MONOSPACE_FONT_SIZE = 10
$BAR_FONT = {{ meta.font }}
$MENU_FONT = {{ meta.font }}
$NOTIFICATION_FONT = {{ meta.font }}

general {
    gaps_in = {{ shape.gaps_in }}
    gaps_out = {{ shape.gaps_out }}
    border_size = {{ shape.border }}
{% if fx %}
    # specular rim: a lit edge that fades across the pane, like light catching glass
    col.active_border = {{ palette.text | a:glass.rim_hi | hypr }} {{ palette.text | a:glass.rim_lo | hypr }} {{ palette.text | a:glass.rim_hi | hypr }} 135deg
    col.inactive_border = {{ palette.text | a:glass.rim_lo | hypr }} {{ palette.text | a:glass.rim_lo | hypr }} 135deg
{% else %}
    col.active_border = {{ palette.accent | hypr }}
    col.inactive_border = {{ palette.separator | hypr }}
{% endif %}
    layout = dwindle
    resize_on_border = true
    extend_border_grab_area = 12
}

group {
    col.border_active = {{ palette.accent | hypr }}
    col.border_inactive = {{ palette.separator | hypr }}
    col.border_locked_active = {{ palette.accent2 | hypr }}
    col.border_locked_inactive = {{ palette.separator | hypr }}

    groupbar {
        font_size = 10
        gradients = true
        rounding = {{ shape.radius_xs }}
        col.active = {{ palette.accent | a:0.85 | hypr }}
        col.inactive = {{ palette.raised2 | a:0.6 | hypr }}
        text_color = {{ palette.on_accent | hypr }}
    }
}

decoration {
    rounding = {{ shape.radius }}
    rounding_power = {{ shape.power }}
    active_opacity = {{ glass.window_active }}
    inactive_opacity = {{ glass.window_inactive }}
    fullscreen_opacity = 1.0
    dim_inactive = false

    shadow {
        enabled = {% if fx %}true{% else %}false{% endif %}
        range = {{ glass.shadow_range }}
        render_power = 3
        offset = 0 {{ glass.shadow_y }}
        color = {{ glass.shadow_color | a:glass.shadow_alpha | hypr }}
    }

    blur {
        enabled = {% if fx %}true{% else %}false{% endif %}
        size = {{ glass.blur_size }}
        passes = {{ glass.blur_passes }}
        noise = {{ glass.noise }}
        contrast = {{ glass.contrast }}
        brightness = {{ glass.brightness }}
        vibrancy = {{ glass.vibrancy }}
        vibrancy_darkness = {{ glass.vibrancy_dark }}
        popups = true
        popups_ignorealpha = 0.2
        input_methods = true
        new_optimizations = on
        ignore_opacity = on
        xray = false
    }
}

animations {
    enabled = true
    bezier = themeCurve, {{ motion.bezier }}
    animation = windows, 1, {{ motion.win_in }}, themeCurve, popin 88%
    animation = windowsOut, 1, {{ motion.win_out }}, themeCurve, popin 88%
    animation = windowsMove, 1, {{ motion.win_in }}, themeCurve
    animation = fade, 1, {{ motion.fade }}, themeCurve
    animation = border, 1, {{ motion.fade }}, themeCurve
    animation = layers, 1, {{ motion.win_in }}, themeCurve, fade
    animation = workspaces, 1, {{ motion.ws }}, themeCurve, slide
}

{% if fx %}
layerrule = blur true, match:namespace waybar
layerrule = ignore_alpha 0.15, match:namespace waybar
layerrule = blur true, match:namespace swaync-control-center
layerrule = ignore_alpha 0.15, match:namespace swaync-control-center
layerrule = blur true, match:namespace swaync-notification-window
layerrule = ignore_alpha 0.15, match:namespace swaync-notification-window
layerrule = blur true, match:namespace logout_dialog
{% endif %}
